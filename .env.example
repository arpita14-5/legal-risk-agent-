# LexGuard Environment Configuration

# Server
PORT=5000
NODE_ENV=development
JWT_SECRET=lexguard_super_secret_jwt_key_academic_2025_change_in_production
CORS_ORIGIN=http://localhost:5173

# Database (PostgreSQL + pgvector)
# If left blank or unreachable, LexGuard automatically activates its robust embedded/in-memory vector database fallback!
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lexguard

# AI & LLM Providers
# If no API key is provided, LexGuard automatically activates its deterministic "Demo AI Mode" with full clause extraction & risk analysis!
AI_PROVIDER=demo
# Supported: "demo", "openai", "gemini"

# OpenAI Configuration (Optional)
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# Google Gemini Configuration (Optional)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Storage
UPLOAD_DIR=./uploads
STORAGE_PATH=./uploads
